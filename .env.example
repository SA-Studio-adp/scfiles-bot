# ── required ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=                # your admin bot's token, from @BotFather
BACKEND_URL=                   # e.g. https://your-backend.onrender.com
MONGODB_URI=                   # e.g. mongodb+srv://user:pass@cluster.mongodb.net
                                # required — replaces every local .json state file
                                # (admins, backup target, notify channels, upload history)

# ── optional — core ──────────────────────────────────────────────────────
MONGODB_DB=scfiles_admin_bot     # database name (created automatically)
TMDB_API_KEY=                  # fallback if BACKEND_URL's /api/tmdb proxy is unavailable
ADMIN_IDS=                     # comma-separated Telegram user IDs; empty = everyone is admin
BACKUP_CHAT_ID=                # only used the very first run, before /setbackup has been
                                # saved to Mongo — after that Mongo is the source of truth
WEB_HOST=0.0.0.0
WEB_PORT=8080
BOT_WEB_URL=                   # public HTTPS URL of this bot's web server, e.g. https://mybot.onrender.com
                                # REQUIRED (and must be https://) for the "Schedule Notification"
                                # button to appear — Telegram Web App buttons refuse http/localhost
AUTO_PING_INTERVAL_MIN=4
ADMIN_TOKEN=changeme           # protects /admin and /admin/logs — CHANGE THIS
LOG_FILE=bot.log

# ── optional — v4/v5 channel notifications ──────────────────────────────
NOTIFY_BOT_TOKEN=               # a SEPARATE bot token — posts uploads, answers /start & /uploads
# WEBSITE_LINK, CHANNEL_HANDLE, REQUESTS_HANDLES aren't env vars — set them
# at the top of scfiles_bot/messages.py (they're wording, not secrets).

# ── required — v4.2 subtitle extraction bot (Pyrogram, not the HTTP Bot API) ─
# This bot runs on Pyrogram instead of python-telegram-bot specifically so it
# can move files up to ~2GB — Telegram's cloud HTTP Bot API (what the two
# bots above use) hard-caps downloads at 20MB / uploads at 50MB with no way
# around it. Pyrogram talks MTProto directly, same as official Telegram
# clients, so no separate server or extra URL is needed.
SUB_BOT_TOKEN=                 # another SEPARATE bot token — DM it a video, get back .srt files
TELEGRAM_API_ID=               # free at https://my.telegram.org/apps — log in as the bot owner
TELEGRAM_API_HASH=             # same page as above
SUBS_MAX_FILE_MB=1900          # real MTProto ceiling for bot file transfers is ~2000MB
SUBS_OCR_ENABLED=0             # 1 = also try OCR on hardcoded/burned-in subs when no track exists
SUBS_OCR_INTERVAL=1.0          # seconds between OCR frame samples (only used if OCR enabled)

