# ── required ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=                # your admin bot's token, from @BotFather
BACKEND_URL=                   # e.g. https://your-backend.onrender.com

# ── optional — core ──────────────────────────────────────────────────────
TMDB_API_KEY=                  # fallback if BACKEND_URL's /api/tmdb proxy is unavailable
ADMIN_IDS=                     # comma-separated Telegram user IDs; empty = everyone is admin
BACKUP_CHAT_ID=                # default chat/channel for scheduled + /backup uploads
WEB_HOST=0.0.0.0
WEB_PORT=8080
BOT_WEB_URL=                   # public URL of this bot's web dashboard, e.g. https://mybot.onrender.com
AUTO_PING_INTERVAL_MIN=4
BACKUP_CONFIG_FILE=.backup_config.json
ADMINS_CONFIG_FILE=.admins_config.json
ADMIN_TOKEN=changeme           # protects /admin and /admin/logs — CHANGE THIS
LOG_FILE=bot.log

# ── optional — v4 channel notifications ─────────────────────────────────
NOTIFY_BOT_TOKEN=               # a SEPARATE bot token, used only to post to channels
CHANNELS_CONFIG_FILE=.channels_config.json
